menu "Banc d'essai"

    menu "Fonctions activées"
        comment "Fonctions compilées ; au démarrage, un écran de sélection permet d'en désactiver"

        config BANC_F_ECRAN
            bool "Écran (tableau de bord)"
            default y
            depends on !BANC_ECRAN_AUCUN
            help
                Modèle d'écran : menu « Écran » ci-dessous. Sans écran, le banc se
                pilote par le bouton BOOT et la console.

        config BANC_TACTILE
            bool "Dalle tactile GT911 (boutons à l'écran)"
            default y
            depends on BANC_F_ECRAN
            help
                Dalle tactile de l'écran 7 pouces du kit, sur le bus I2C partagé
                (adresse 0x5D ou 0x14, détectée au démarrage). Absente : le banc
                reste utilisable par le bouton BOOT et la console.

        config BANC_F_CAMERA
            bool "Caméra, vidéo et photo"
            default y

        config BANC_SON
            bool "Son (micro ES8311, piste AAC, vumètre)"
            default y
            depends on BANC_F_CAMERA

        config BANC_F_SD
            bool "Carte SD (vidéos, photos, journal, tests de débit)"
            default y

        config BANC_F_PIR
            bool "PIR et détection"
            default y

        config BANC_F_NUIT
            bool "Nuit : LED IR, filtre IR-cut, monochrome, soleil"
            default y

        config BANC_F_BATTERIE
            bool "Batterie (ADC)"
            default y

        config BANC_F_TEMPERATURE
            bool "Température de la puce"
            default y

        config BANC_F_SUIVI
            bool "Photo de suivi périodique"
            default y
            depends on BANC_F_CAMERA && BANC_F_SD

        config BANC_F_CONSOLE
            bool "Console série (commandes)"
            default y

        config BANC_F_WIFI
            bool "Wi-Fi (coprocesseur ESP32-C6) et tableau de bord web"
            default y
            help
                Point d'accès « BANC-NID » (ou station sur un réseau existant) et
                page web servie par le banc : état en direct, vue caméra, boutons,
                fichiers de la carte SD, console. Permet d'utiliser le banc sans
                écran. Réglages : menu « Wi-Fi et tableau de bord web » ci-dessous.
                Le composant nid_wifi reste compilé (dépendance fixe), mais sans
                cette option aucun code Wi-Fi n'est appelé ni lié.

        config BANC_SELECTION_S
            int "Écran de sélection au démarrage : démarrage automatique après (s ; 0 = pas d'écran)"
            range 0 60
            default 5
            help
                Au démarrage, la liste des fonctions compilées est proposée (écran
                tactile, bouton BOOT : appui court = suivante, appui long =
                basculer / valider ; console : « fonctions »). Sans action, le banc
                démarre au bout de ce délai avec la dernière sélection (mémorisée
                en NVS).
    endmenu

    menu "Wi-Fi et tableau de bord web"
        depends on BANC_F_WIFI

        choice BANC_WIFI_MODE
            prompt "Mode Wi-Fi au démarrage"
            default BANC_WIFI_MODE_AP
            help
                Point d'accès : le PC ou le téléphone se connecte au réseau du banc
                puis ouvre http://192.168.4.1. Station : le banc rejoint un réseau
                existant (adresse donnée par sa box ou son routeur, affichée par la
                commande « wifi » et l'onglet WI-FI). La console « wifi ap » /
                « wifi sta <ssid> <mdp> » change de mode et le mémorise en NVS.

            config BANC_WIFI_MODE_AP
                bool "Point d'accès (192.168.4.1)"
            config BANC_WIFI_MODE_STA
                bool "Station (rejoindre un réseau existant)"
        endchoice

        config BANC_WIFI_AP_SSID
            string "Nom du point d'accès (SSID)"
            default "BANC-NID"

        config BANC_WIFI_AP_MDP
            string "Mot de passe du point d'accès (WPA2, 8 à 63 caractères)"
            default "banc-nid-essai"
            help
                À changer pour chaque banc utilisé hors du laboratoire. Il n'est
                jamais affiché ni renvoyé par la page web. Invalide (moins de 8
                caractères) : le Wi-Fi ne démarre pas et la fonction est « en défaut ».

        config BANC_WIFI_AP_CANAL
            int "Canal du point d'accès"
            range 1 13
            default 6

        config BANC_WIFI_AP_CLIENTS
            int "Nombre maximal d'appareils connectés au point d'accès"
            range 1 4
            default 3

        config BANC_WIFI_STA_SSID
            string "Station : réseau à rejoindre (SSID)"
            default ""
            help
                Vide : réglage par la console (« wifi sta <ssid> <mdp> »), mémorisé.

        config BANC_WIFI_STA_MDP
            string "Station : mot de passe du réseau (vide : réseau ouvert)"
            default ""

        config BANC_WIFI_STA_DELAI_S
            int "Station : attente de la connexion (s)"
            range 5 120
            default 20

        config BANC_WIFI_STA_REPLI
            bool "Station introuvable : repli sur le point d'accès"
            default y
            help
                Si le réseau n'est pas rejoint dans le délai, le banc ouvre son point
                d'accès (il reste joignable sans écran). Sinon, il réessaie sans fin.

        config BANC_WEB_VUE_LARGEUR
            int "Vue caméra de la page : largeur maximale (pixels)"
            range 320 960
            default 640

        config BANC_WEB_VUE_QUALITE
            int "Vue caméra de la page : qualité JPEG"
            range 20 90
            default 50

        config BANC_WEB_VUE_IPS
            int "Vue caméra de la page : images par seconde (hors enregistrement)"
            range 1 12
            default 8

        config BANC_WEB_VUE_ENREG_IPS
            int "Vue caméra de la page : images par seconde pendant un enregistrement (0 = aucune)"
            range 0 5
            default 2
            help
                Comme la vue de l'écran : quelques images par seconde seulement, les
                autres sont sautées sans attendre, pour ne pas faire perdre d'images
                à la vidéo. Comparer « perdues » dans le bilan avec 0.

        config BANC_WEB_SUPPRESSION
            bool "Page web : suppression des fichiers de la carte SD"
            default y
            help
                Bouton « supprimer » (avec confirmation) dans la liste des fichiers.
    endmenu

    comment "Bouton BOOT, vidéo manuelle (appui long ou commande « video »)"

    config BANC_BOUTON_GPIO
        int "GPIO du bouton (actif bas)"
        range 0 54
        default 35
        help
            Bouton BOOT de l'ESP32-P4X-Function-EV-Board (GPIO35, vers la masse,
            résistance de rappel sur la carte). Appui court : armer / désarmer la
            surveillance PIR ; appui long (1 s) : vidéo manuelle ; appui pendant
            un enregistrement : arrêt anticipé (fichier fermé proprement).
            Maintenir BOOT pendant un appui sur RESET passe toujours la carte en
            mode téléchargement.

    config BANC_DUREE_S
        int "Durée d'une vidéo manuelle (s)"
        range 1 300
        default 10

    comment "Surveillance PIR (logique et réglages du firmware ; -1 = valeur par défaut de nid_config)"

    config BANC_ARME_DEMARRAGE
        bool "Surveillance armée au démarrage"
        default y
        help
            Armée : un front du PIR lance une séquence après la chauffe du PIR.
            Appui court sur BOOT, bouton ARMER de l'écran ou « armer on|off ».

    config BANC_DET_DUREE_S
        int "Durée d'une séquence sur détection (s ; -1 = 30 s du firmware)"
        range -1 300
        default -1

    config BANC_DET_DELAI_S
        int "Délai entre déclenchements (s ; -1 = 60 s du firmware ; 0 = enchaînement)"
        range -1 3600
        default -1
        help
            Compté depuis la fin de la séquence, comme le firmware. À 0, les
            séquences s'enchaînent tant que le PIR reste actif.

    config BANC_DET_CHAUFFE_S
        int "Chauffe du PIR après la mise sous tension (s ; -1 = 60 s du firmware)"
        range -1 120
        default -1

    config BANC_DET_SENSIBILITE
        int "Sensibilité 1 à 5 (0 = 3 du firmware)"
        range 0 5
        default 0
        help
            Durée minimale d'activité du PIR pour valider un déclenchement :
            5 → 0 ms, 4 → 50 ms, 3 → 150 ms, 2 → 300 ms, 1 → 500 ms. Plus court :
            fausse détection, vidéo supprimée.

    config BANC_PIR_ENCHAINEES_MAX
        int "Séquences enchaînées au plus (délai à 0 et PIR toujours actif)"
        range 1 100
        default 10

    config BANC_SUIVI_MIN
        int "Intervalle des photos de suivi (min ; -1 = 15 min du firmware ; 0 = aucune)"
        range -1 1440
        default -1
        help
            Photos prises tant que la surveillance est armée. Pour l'essai :
            commande « suivi 1 ».

    choice BANC_NUIT_DEFAUT
        prompt "Mode jour/nuit au démarrage"
        default BANC_NUIT_DEFAUT_JOUR
        help
            Jour forcé par défaut (image couleur, LED IR éteintes). « nuit auto »
            applique la décision du firmware (lever / coucher du soleil à la
            latitude / longitude de nid_config).

        config BANC_NUIT_DEFAUT_JOUR
            bool "Jour forcé"
        config BANC_NUIT_DEFAUT_AUTO
            bool "Automatique (comme le firmware)"
        config BANC_NUIT_DEFAUT_NUIT
            bool "Nuit forcée"
    endchoice

    config BANC_SD_TEST_MO
        int "Taille du test d'écriture de la carte SD (Mo)"
        range 1 1024
        default 32

    comment "Vidéo (mêmes valeurs que config.ini)"

    choice BANC_RESOLUTION
        prompt "Résolution vidéo"
        default BANC_RES_1920X1080
        help
            Mêmes valeurs que « resolution » dans config.ini du firmware. Le format
            du capteur est choisi automatiquement (voir sdkconfig.defaults).

        config BANC_RES_1920X1080
            bool "1920x1080"
        config BANC_RES_1280X960
            bool "1280x960"
        config BANC_RES_1280X720
            bool "1280x720"
    endchoice

    config BANC_LARGEUR
        int
        default 1920 if BANC_RES_1920X1080
        default 1280

    config BANC_HAUTEUR
        int
        default 1080 if BANC_RES_1920X1080
        default 960 if BANC_RES_1280X960
        default 720

    config BANC_IPS
        int "Images par seconde"
        range 1 60
        default 30
        help
            Cadence effective : plus grand diviseur de la cadence du capteur ne
            dépassant pas cette valeur (capteur à 30 i/s : 30, 15, 10...).

    config BANC_DEBIT_KBPS
        int "Débit vidéo H.264 (kbit/s)"
        range 100 25000
        default 4000

    config BANC_QUALITE_JPEG
        int "Qualité des photos JPEG (commande « photo »)"
        range 10 100
        default 80

    config BANC_FUSEAU
        string "Fuseau horaire (format TZ POSIX)"
        default "CET-1CEST,M3.5.0,M10.5.0/3"
        help
            Heure locale de l'incrustation, des noms de fichiers et du journal.
            France métropolitaine par défaut ; Martinique : AST4.

    comment "Écran (débogage)"

    choice BANC_ECRAN
        prompt "Écran"
        default BANC_ECRAN_EK79007
        help
            Écran MIPI-DSI relié au connecteur DSI de la carte (nappe « inversée »
            du kit). Sans écran, le banc reste utilisable par le bouton et la console.

        config BANC_ECRAN_EK79007
            bool "7 pouces 1024x600 du kit (EK79007)"
        config BANC_ECRAN_ILI9881C
            bool "800x1280 (ILI9881C)"
        config BANC_ECRAN_AUCUN
            bool "Aucun"
    endchoice

    config BANC_ECRAN_RETRO_GPIO
        int "GPIO du rétroéclairage (broche PWM de l'adaptateur ; -1 = aucun)"
        range -1 54
        default 26 if BANC_ECRAN_EK79007
        default 23
        depends on !BANC_ECRAN_AUCUN

    config BANC_ECRAN_RESET_GPIO
        int "GPIO de reset de l'écran (broche RST_LCD de l'adaptateur ; -1 = aucun)"
        range -1 54
        default 27 if BANC_ECRAN_EK79007
        default -1
        depends on !BANC_ECRAN_AUCUN

    config BANC_VUE_ENREG
        bool "Vue caméra pendant l'enregistrement"
        default y
        depends on !BANC_ECRAN_AUCUN
        help
            Affiche quelques images par seconde pendant l'enregistrement (les
            autres sont sautées). Désactiver pour vérifier que l'affichage ne fait
            pas perdre d'images (comparer « perdues » dans le bilan).

    config BANC_VUE_ENREG_IPS
        int "Images affichées par seconde pendant l'enregistrement"
        range 1 10
        default 3
        depends on BANC_VUE_ENREG

    config BANC_TACTILE_MIROIR_X
        bool "Tactile : miroir horizontal"
        default y
        depends on BANC_TACTILE
        help
            Réglage du BSP de la carte pour l'écran EK79007. Si un appui à gauche
            agit à droite, inverser ce réglage.

    config BANC_TACTILE_MIROIR_Y
        bool "Tactile : miroir vertical"
        default y
        depends on BANC_TACTILE

    config BANC_TACTILE_ECHANGE_XY
        bool "Tactile : échanger X et Y"
        default n
        depends on BANC_TACTILE

endmenu
